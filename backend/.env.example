PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_strong_jwt_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=your_frontend_live_url
PUBLIC_SITE_URL=your_backend_live_url

ENABLE_HTTPS=false
HTTPS_PORT=5443
FORCE_HTTPS=false
ENABLE_HSTS=false

SSL_KEY_PATH=
SSL_CERT_PATH=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=40

SUPER_ADMIN_EMAIL=abdullahalvi@gmail.com
SUPER_ADMIN_BOOTSTRAP_KEY=your_super_admin_bootstrap_key

# Recommended for Vercel: Resend HTTPS API.
# onboarding@resend.dev sirf Resend account ke apne email ko test mail bhej sakta hai.
# Public OTP delivery ke liye Resend mein apna domain verify karein.
RESEND_API_KEY=
RESEND_FROM="Paper Forge <verify@your-domain.com>"
RESEND_TEST_RECIPIENT=

# Generic SMTP fallback (Gmail aur dosray providers).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Paper Forge <no-reply@example.com>"
# Gmail quick setup:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your_16_character_gmail_app_password
# SMTP_FROM="Paper Forge <your-gmail@gmail.com>"
#
# Also supported on Vercel/other hosts:
# EMAIL_SERVER_HOST, EMAIL_SERVER_PORT, EMAIL_SERVER_USER, EMAIL_SERVER_PASSWORD, EMAIL_FROM
# MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASS, MAIL_FROM
# GMAIL_USER, GMAIL_APP_PASSWORD
ALLOW_DEV_EMAIL_CODES=false
SKIP_EMAIL_DOMAIN_CHECK=false
REGISTRATION_CODE_TTL_MINUTES=10
REGISTRATION_CODE_RESEND_SECONDS=60
REGISTRATION_MAX_VERIFY_ATTEMPTS=5

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

MONTHLY_PRICE_PKR=2000
YEARLY_PRICE_PKR=20000

JAZZCASH_NUMBER=
JAZZCASH_ACCOUNT_NAME=
